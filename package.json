{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Layered Playwright + TypeScript automation framework for UI, REST API and accessibility testing, with contract validation, fixtures and CI reporting.",
  "author": "Manikandan Kandasamy",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --project=a11y",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "allure-commandline": "^2.46.2",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "zod": "^4.6.7"
  }
}
