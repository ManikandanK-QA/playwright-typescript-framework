# Copy to `.env` and adjust for your environment.
# Every value below is optional: the framework falls back to the public demo
# targets and their documented demo credentials, so a fresh clone runs as-is.

# UI target (SauceDemo)
BASE_URL=https://www.saucedemo.com

# REST target (Restful Booker)
API_BASE_URL=https://restful-booker.herokuapp.com

# SauceDemo credentials
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Restful Booker credentials
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# debug | info | warn | error
LOG_LEVEL=info
